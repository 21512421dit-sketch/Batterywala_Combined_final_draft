SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@batterywala.local
ADMIN_PASSWORD=ChangeMe123!
MAX_UPLOAD_MB=25
DATABASE_URL=sqlite:///batterywala.db
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Internal inbox that receives each Engine D-Carb customer enquiry.
# Falls back to SMTP_FROM/SMTP_USERNAME when blank.
ENGINE_DCARB_EMAIL=
SMS_WEBHOOK_URL=
# Public HTTPS origin for quotation links sent by SMS (no trailing path).
PUBLIC_BASE_URL=
# Optional domain names when both public sites point to this same deployment.
BATTERYWALA_DOMAIN=
ENGINE_DCARB_DOMAIN=
# Meta WhatsApp Cloud API. Keep the access token only in the private .env/host secrets.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
ENGINE_DCARB_WHATSAPP_NUMBER=919607576029
# Admin receives every Engine D-Carb service and machine enquiry.
ENGINE_DCARB_ADMIN_WHATSAPP_NUMBER=919067671513
WHATSAPP_TEMPLATE_LANGUAGE=en_IN
# Use Meta hello_world and notify only the customer when using a Meta test sender.
WHATSAPP_TEST_MODE=false
WHATSAPP_CUSTOMER_TEMPLATE=engine_dcarb_service_quote
WHATSAPP_CENTRE_TEMPLATE=engine_dcarb_new_service_lead
# Defaults to WHATSAPP_CENTRE_TEMPLATE when blank; both use the same 5 variables.
WHATSAPP_ADMIN_TEMPLATE=
WHATSAPP_MACHINE_CUSTOMER_TEMPLATE=engine_dcarb_machine_enquiry_confirmation
WHATSAPP_MACHINE_ADMIN_TEMPLATE=engine_dcarb_admin_machine_lead
# Change this only when upgrading to a supported Meta Graph API version.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
# Meta App > App settings > Basic > App secret (not the access token or PIN).
WHATSAPP_APP_SECRET=
